# Database — local docker compose (compose.yaml):
# DATABASE_URL=postgresql://santri:santri@localhost:5432/santri
# Database — hosted (Supabase):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Migrations (drizzle-kit) need a direct/session connection. Hosted poolers in
# transaction mode (e.g. Supabase port 6543) break introspection, so point this
# at the session pooler / direct port (e.g. Supabase 5432). Falls back to
# DATABASE_URL when unset.
# MIGRATE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# better-auth
BETTER_AUTH_SECRET=generate-with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
